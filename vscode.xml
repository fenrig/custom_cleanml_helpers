    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code - Insiders/CachedData"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code - Insiders/GPUCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code - Insiders/DawnCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code - Insiders/ShaderCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code - Insiders/GrShaderCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code - Insiders/Crashpad/completed"/>
    <action command="delete" search="walk.all" path="$XDG_CACHE_HOME/Code - Insiders"/>

    <action command="delete" search="walk.all" path="$HOME/.config/Code - Insiders/Cache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code - Insiders/Code Cache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code - Insiders/CachedData"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code - Insiders/GPUCache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code - Insiders/DawnCache"/>
