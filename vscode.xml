<?xml version="1.0" encoding="UTF-8"?>

<cleaner id="vscode_family" os="linux">
  <label>VS Code family</label>
  <description>Cache cleanup for VS Code, VS Code Insiders, VSCodium, Cursor, Windsurf, and Code OSS</description>
  <running type="exe" os="linux" same_user="true">code</running>
  <running type="exe" os="linux" same_user="true">code-insiders</running>
  <running type="exe" os="linux" same_user="true">codium</running>
  <running type="exe" os="linux" same_user="true">cursor</running>
  <running type="exe" os="linux" same_user="true">windsurf</running>
  <running type="exe" os="linux" same_user="true">code-oss</running>

  <option id="vscode_cache">
    <label>Visual Studio Code cache</label>
    <description>Delete VS Code cache files</description>
    <warning>Close VS Code before cleaning.</warning>

    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/Cache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/Code Cache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/CachedData"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/GPUCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/DawnCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/ShaderCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/GrShaderCache"/>
    <action command="delete" search="walk.all" path="$XDG_CONFIG_HOME/Code/Crashpad/completed"/>
    <action command="delete" search="walk.all" path="$XDG_CACHE_HOME/Code"/>

    <action command="delete" search="walk.all" path="$HOME/.config/Code/Cache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code/Code Cache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code/CachedData"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code/GPUCache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code/DawnCache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code/ShaderCache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code/GrShaderCache"/>
    <action command="delete" search="walk.all" path="$HOME/.config/Code/Crashpad/completed"/>
    <action command="delete" search="walk.all" path="$HOME/.cache/Code"/>
  </option>

